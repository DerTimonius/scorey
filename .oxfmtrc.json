{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortImports": true,
  "sortTailwindcss": {
    "functions": ["cn", "cva"],
    "stylesheet": "./src/index.css"
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    ".github/*",
    "**/tests/.auth/*"
  ]
}
